# ============================================================
#  复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# ------------------------------------------------------------
#  模型供应商选择：ark（火山方舟，默认）| huawei（华为云 MaaS）
# ------------------------------------------------------------
AI_PROVIDER=ark
# 主通道不具备某类能力时的备用通道（华为云无音视频直传，默认回退方舟）
# 留空 = 不回退，直接报错
AI_FALLBACK_PROVIDER=ark

# ============================================================
#  华为云 MaaS（AI_PROVIDER=huawei 时必填；ark 时留空即可）
#  注意：MaaS 预置服务目前仅支持「西南-贵阳一」区域
# ------------------------------------------------------------
#  MaaS 控制台 → 模型推理 > 在线推理 → 已开通模型 → 「API 调用」页签复制
HW_MAAS_BASE_URL=
#  MaaS 控制台 → API Key 管理 → 创建（明文仅显示一次，请立刻保存）
HW_MAAS_API_KEY=
#  鉴权方式：bearer（默认，API Key）| apig（API 网关 AppCode）
HW_MAAS_AUTH=bearer
#  留空则使用代码内默认值（Qwen2.5-VL-7B-Instruct / DeepSeek-V4.1-Flash）
HW_TEXT_MODEL=
HW_VISION_MODEL=

#  语音交互服务 SIS（音频转写，AI_PROVIDER=huawei 时启用音频能力）
#  录音文件识别流程：音频 → 上传 OBS 临时对象 → SIS 异步转写 → 删除 OBS 对象 → 文本模型复检
#  控制台 → 我的凭证 → 访问密钥 → 新增访问密钥（AK/SK，明文仅显示一次）
HW_AK=
HW_SK=
#  项目 ID：控制台 → 我的凭证 → 项目列表 → 复制对应区域的项目 ID
HW_PROJECT_ID=
#  区域，例如 cn-north-4（华北-北京四）
HW_REGION=cn-north-4
#  SIS 服务端点，例如 https://sis-ext.cn-north-4.myhuaweicloud.com
HW_SIS_ENDPOINT=
#  音频转写临时落地的 OBS 桶名（转写完成后立即删除对象，建议给桶配 1 天生命周期兜底）
HW_OBS_BUCKET=
#  OBS 服务端点，例如 https://obs.cn-north-4.myhuaweicloud.com
HW_OBS_ENDPOINT=
#  SIS 模型特征串（默认 chinese_16k_media；可选 chinese_8k_common / chinese_16k_conversation）
HW_SIS_PROPERTY=
# ============================================================

# 必填：火山方舟 API Key（AI_PROVIDER=ark 时）
# 获取地址 https://console.volcengine.com/ark -> API Key 管理
ARK_API_KEY=your-ark-api-key-here

# 选填：模型 ID
# 视觉理解模型，需支持图片输入
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428
# 纯文本模型（文本语义检测用），留空则复用 ARK_VISION_MODEL
ARK_TEXT_MODEL=
# 音频模型（走 Chat Completions 的 input_audio），留空则复用 ARK_VISION_MODEL
ARK_AUDIO_MODEL=
# 视频模型（走 Chat Completions 的 video_url），留空则复用 ARK_VISION_MODEL
ARK_VIDEO_MODEL=

# 选填：接口地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ============================================================
#  存储：sqlite（默认，零依赖）| mysql（华为云 RDS）
# ============================================================
DB_DRIVER=sqlite

#  DB_DRIVER=mysql 时必填。华为云 RDS 控制台 → 实例 → 连接信息
#  注意：应用与 RDS 必须在同一区域、同一 VPC，走内网地址（不要用公网）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=privacy_sentinel
#  RDS 要求 SSL 时设为 true；是否校验证书用 MYSQL_SSL_VERIFY=true
MYSQL_SSL=false
MYSQL_SSL_VERIFY=false
#  连接池大小
MYSQL_POOL_SIZE=10

# ============================================================
#  缓存 / 共享限流：华为云 DCS for Redis（选填，不配则走内存）
# ============================================================
#  格式：redis://:<密码>@<内网地址>:6379/0
REDIS_URL=

# 选填：每分钟每 IP 最大请求数（0 = 不限）
RATE_LIMIT_PER_MINUTE=30

# 选填：服务端口，Railway/Render 会自动注入 PORT
PORT=8080
