# ============================================================
#  复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# 必填：火山方舟 API Key
# 获取地址 https://console.volcengine.com/ark -> API Key 管理
ARK_API_KEY=your-ark-api-key-here

# 选填：模型 ID
# 视觉理解模型，需支持图片输入
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428
# 纯文本模型（文本语义检测用），留空则复用 ARK_VISION_MODEL
ARK_TEXT_MODEL=
# 音频模型（走 Chat Completions 的 input_audio），留空则复用 ARK_VISION_MODEL
ARK_AUDIO_MODEL=
# 视频模型（走 Chat Completions 的 video_url），留空则复用 ARK_VISION_MODEL
ARK_VIDEO_MODEL=

# 选填：接口地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 选填：每分钟每 IP 最大请求数（0 = 不限）
RATE_LIMIT_PER_MINUTE=30

# 选填：服务端口，Railway/Render 会自动注入 PORT
PORT=8080
