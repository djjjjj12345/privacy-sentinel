# ============================================================
#  复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# 必填：火山方舟 API Key
# 获取地址 https://console.volcengine.com/ark -> API Key 管理
ARK_API_KEY=your-ark-api-key-here

# 选填：模型 ID
# 视觉理解模型，需支持图片输入
ARK_VISION_MODEL=doubao-seed-2-0-mini-260428
# 纯文本模型（文本语义检测用），留空则复用 ARK_VISION_MODEL
ARK_TEXT_MODEL=

# 选填：接口地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 选填：服务端口，Railway 会自动注入 PORT
PORT=8080

# ------------------------------------------------------------
#  P1 预留：火山引擎语音识别（音视频需要，当前版本未启用）
#  注意：该接口要求音频可通过公网 URL 访问，不接受 base64 直传
# ------------------------------------------------------------
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc
VOLC_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLC_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
