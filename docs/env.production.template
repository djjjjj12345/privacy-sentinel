# ============================================================
#  生产环境 .env 模板（华为云）
#  用法：复制为服务器上的 .env 后填入真实值
#  ⚠️ 本文件不含任何真实密钥，只有占位符。切勿把填好的 .env 提交到 git。
#  生成依据：本机 .env 实测（HW_PROJECT_ID 与 cn-north-4 一致）+ services/ 实际读取的变量
# ============================================================

# ---------- 1. 基础 ----------
# 华为云 ECS 的安全组需放行此端口；未备案时只能走 http://公网IP:8080
PORT=8080
# 线上域名，决定 OG 图 / canonical / sitemap 的绝对地址
PUBLIC_BASE_URL=http://<ECS公网IP>:8080

# ---------- 2. AI 通道 ----------
# 现状：火山方舟（ARK_API_KEY 已配置，可正常运行）
# 拿到华为云 MaaS Key 后改成 huawei，SIS 才会真正被调用（见报告第八节）
AI_PROVIDER=ark
# 主通道失败时回退到哪家
AI_FALLBACK_PROVIDER=ark
ARK_API_KEY=<已有，沿用本机那一份>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-2-0-mini-260428

# ---------- 3. 华为云 MaaS（拿到 Key 后填，SIS 依赖它）----------
# ⚠️ 硬限制：MaaS 预置服务目前仅支持「西南-贵阳一」区域
# 控制台 → MaaS → 模型推理 > 在线推理 > 已开通模型 > 「API 调用」页签
HW_MAAS_BASE_URL=
HW_MAAS_API_KEY=
HW_MAAS_AUTH=bearer

# ---------- 4. 华为云 SIS + OBS（本机已配好，直接沿用）----------
# 这七项本机 .env 均已填写且经 resolve-project-id.js 验证有效
HW_AK=<沿用本机>
HW_SK=<沿用本机>
# 已验证：与 cn-north-4 的项目 ID 一致，不要改成账号 ID（32 位十六进制，极易填错）
HW_PROJECT_ID=01a14ef0436c7a2a82a5f940238ff342
HW_REGION=cn-north-4
HW_SIS_ENDPOINT=https://sis-ext.cn-north-4.myhuaweicloud.com
HW_OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
HW_OBS_BUCKET=<沿用本机>
# 极速版需在 SIS 控制台单独开通，未开通会报 SIS.0004
HW_SIS_MODE=auto
HW_SIS_PROPERTY=chinese_16k_media

# ---------- 5. 数据库：SQLite → 华为云 RDS ----------
# ⚠️ 这是赛题硬要求「关联 RDS」的落点
DB_DRIVER=mysql
# 应用与 RDS 必须同区域、同 VPC，走内网地址（不要用公网地址）
MYSQL_HOST=<RDS内网地址，形如 xxx.mysql.rds.cn-north-4.myhuaweicloud.com>
MYSQL_PORT=3306
MYSQL_USER=<RDS账号>
MYSQL_PASSWORD=<RDS密码>
MYSQL_DATABASE=privacy_sentinel
# RDS 要求 SSL 时设 true
MYSQL_SSL=false
MYSQL_SSL_VERIFY=false

# ---------- 6. 缓存：内存 → 华为云 DCS Redis ----------
# ⚠️ 这也是赛题硬要求「关联 Redis」的落点
# 不配则 services/redis.js:20 返回 null，限流与会话退回内存
# 格式：rediss://<用户名>:<密码>@<DCS内网地址>:6379/0 （DCS 开启 SSL 时用 rediss://）
REDIS_URL=rediss://<用户名>:<密码>@<DCS内网地址>:6379/0
# 连接超时，云上网络抖动时适当放大
REDIS_CONNECT_TIMEOUT_MS=5000

# ---------- 7. 数据目录（必须在代码目录之外）----------
# 否则发版 / git clean 会连数据库一起删掉
DATA_DIR=/srv/privacy-sentinel/data

# ---------- 8. 安全与限流 ----------
# 留空 = 沿用 *（上线稳定后应收紧为你自己的域名）
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
# 挡超大 payload；保留既有「AI 截断 12000 + 本地扫全文」的降级能力
MAX_TEXT_LENGTH=200000

# ============================================================
#  上线验收一分钟自查
# ------------------------------------------------------------
#  curl http://<地址>/api/health
#  ✅ dbDriver 应为 mysql       ← 证明 RDS 已接
#  ✅ redis 不应为 disabled     ← 证明 DCS 已接
#  ✅ capabilities.audio 为 true
#  ✅ db 应为 ok
# ============================================================
