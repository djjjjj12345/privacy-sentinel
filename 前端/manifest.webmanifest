{
  "name": "隐私哨兵 · Privacy Sentinel",
  "short_name": "PrivacySentinel",
  "description": "多模态敏感信息检测：文本/图片/音频/视频全通道，AI 识别 + 本地正则双引擎。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1d4ed8",
