# 依赖
node_modules/
venv/
__pycache__/

# 环境变量（绝对不要提交）
.env
.env.local
.env.*.local

# 备份与临时文件
*.bak
*.bak-*
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 早期副本（死代码，含已泄露的旧 Key 示例，不再跟踪）
后端/

# 编辑器
.vscode/
.idea/

# 本地 SQLite 数据（用户账号与历史，绝不提交）
data/
*.db

# 华为云能力探测报告（可能含账号侧报错信息，不提交）
probe-report.json

# 本地测试录音与转码产物（含真实语音，不入库）
*.m4a
*.mp3
*.wav
*.pcm
录音*

# 真实浏览器验收的调试截图（无输入框站点的空页面，仅本地排查用）
docs/real-browser/*-0-noinput.*

# 华为云码道 CodeArts 本地 IDE 产物（含本地设置，不入库）
.arts/
